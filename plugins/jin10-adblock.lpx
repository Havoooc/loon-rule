#!name=金十数据去广告
#!desc=移除开屏、侧滑页、消息、浮窗、横幅、信息流及弹窗广告；仅匹配明确广告接口。
#!author=Havoc
#!homepage=https://github.com/Havoooc/loon-rule
#!openUrl=https://apps.apple.com/app/id901284508
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/1c/ca/32/1cca328b-f72e-51a2-ac88-de743f942c5c/AppIcon_lgd-0-0-1x_U007epad-0-11-0-0-sRGB-85-220.png/512x512bb.jpg
#!tag=去广告
#!loon_version=3.5.1(978)
#!date=2026-10-31
# 来源：Surge modules/jin10.sgmodule；Map Local 转为原生 Rewrite。

[Rewrite]
# 开屏广告及应用内广告卡片。
request if ${url} ~= /^https:\/\/jad-api\.jin10\.com\/ad[0-9]\// then reject_dict(200)
# 侧滑页、横幅及浮窗广告配置。
request if ${url} ~= /^https:\/\/common-open-api\.jin10\.com\/configuration\/getById\?id=1493$/ then reject_dict(200)
# 搜索与首页热榜中的推广内容。
request if ${url} ~= /^https:\/\/search-open-api\.jin10\.com\/search\/getHotWords(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/cdn\.jin10\.com\/json\/index\/hits_rank\.json\?(?:.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/[0-9a-z]+\.z3c\.jin10\.com\/api\/home\/search\/hot(?:\?.*)?$/ then reject_dict(200)
# 未读消息区域的广告入口。
request if ${url} ~= /^https:\/\/jad-api\.jin10\.com\/mult\/list_unread\?(?:.*)?$/ then reject_dict(200)

[Mitm]
hostname = jad-api.jin10.com, common-open-api.jin10.com, search-open-api.jin10.com, cdn.jin10.com, *.z3c.jin10.com
